{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hisab",
  "version": "0.1.0",
  "identifier": "com.hisab.accounting",
  "build": {
    "beforeDevCommand": "pnpm run desktop:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build:desktop",
    "frontendDist": "../dist/public"
  },
  "app": {
    "windows": [
      {
        "title": "حساب | Hisab",
        "width": 1320,
        "height": 860,
        "minWidth": 840,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:hisab.db"]
    }
  }
}
